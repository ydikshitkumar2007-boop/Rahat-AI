# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Open-Meteo Weather API (Free open access, no key required, optional config)
NEXT_PUBLIC_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# AI API Service Configuration (Server side only)
AI_API_KEY=your-ai-api-key-here
AI_API_MODEL=gemini-1.5-pro

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_SIMULATION=true
